{% macro notes(sections) -%}
{% for section in sections %}
<div class="notes notes-{{ section.tone | default('consejo') }}">
  <div class="notes-title">{{ section.title }}</div>
  <ul>
    {% for item in section['items'] %}<li>{{ item }}</li>{% endfor %}
  </ul>
</div>
{% endfor %}
{%- endmacro %}

{% macro dots(value, total=5, extra='') -%}
<div class="dots {{ extra }}">
  {% for i in range(1, total + 1) %}
  <div class="dot {% if i <= value %}on{% endif %} {{ extra }}"></div>
  {% endfor %}
</div>
{%- endmacro %}

<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<title>Propuesta — {{ hero_card.name }} · cartas recomendadas</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bangers&family=Barlow+Condensed:wght@500;600;700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
:root {
  --primary: {{ palette.primary }};
  --secondary: {{ palette.secondary }};
  --on-primary: {{ palette.on_primary }};
  --on-secondary: {{ palette.on_secondary }};
  --primary-ink: color-mix(in srgb, {{ palette.primary }} 72%, #000);
  --ink: #141414;
  --paper: #f4efe4;
  --paper-light: #fbf8f1;
  --accent: #f2b705;
}
{% include "sheet.css" %}

.proposal-banner {
  background: var(--accent);
  color: #111;
  font-family: 'Barlow Condensed', sans-serif;
  font-weight: 700;
  letter-spacing: .08em;
  text-transform: uppercase;
  text-align: center;
  font-size: 3.1mm;
  padding: 1.4mm 4mm;
  border-bottom: .6mm solid var(--ink);
}

.rec-basics {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 3mm;
}

.rec-basic {
  display: flex;
  gap: 2.4mm;
  align-items: flex-start;
}

.rec-basic img {
  flex: 0 0 auto;
  width: 16mm;
  border-radius: 1mm;
  border: .4mm solid var(--ink);
  background: #ddd;
}

.rec-aspects {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 2.4mm;
}

.rec-aspect {
  border: .6mm solid var(--ink);
  border-radius: 1.6mm;
  overflow: hidden;
  background: #fff;
}

.rec-aspect .bar {
  font-family: 'Barlow Condensed', sans-serif;
  font-weight: 700;
  font-size: 2.7mm;
  letter-spacing: .06em;
  text-transform: uppercase;
  color: #fff;
  padding: .8mm 1.6mm;
  text-align: center;
}

.rec-aspect.aggression .bar { background: #a5232a; }
.rec-aspect.justice .bar { background: #c8a01c; color: #17140a; }
.rec-aspect.leadership .bar { background: #2b5fa8; }
.rec-aspect.protection .bar { background: #2c7a4d; }

.rec-aspect .inner {
  display: flex;
  gap: 2mm;
  padding: 1.8mm;
  align-items: flex-start;
}

.rec-aspect img {
  width: 12mm;
  border-radius: .8mm;
  border: .35mm solid var(--ink);
}

.rec-aspect .name {
  font-family: 'Barlow Condensed', sans-serif;
  font-weight: 700;
  font-size: 3.1mm;
  text-transform: uppercase;
  color: var(--primary-ink);
  line-height: 1.1;
}

.rec-aspect .note,
.rec-basic .note {
  font-size: 2.55mm;
  line-height: 1.3;
  margin: .6mm 0 0;
}

.aside-note {
  font-size: 2.6mm;
  line-height: 1.35;
  opacity: .72;
  margin: 0;
}
</style>
</head>
<body>

<section class="sheet sheet-a">
  <div class="halftone"></div>
  <div class="proposal-banner">Propuesta · no es la hoja oficial · las cartas de abajo son ejemplos</div>

  <header class="header">
    <div>
      <div class="eyebrow">Guía básica de héroe · Marvel Champions LCG</div>
      <div class="hero-name">{{ hero_card.name }}</div>
      <div class="alter-ego-name">{{ alter_ego.name }}</div>
    </div>
  </header>

  <div class="body">
    <div class="row">
      <div class="portrait">
        {% if hero_card.image %}
        <img class="card-art" src="{{ hero_card.image }}" alt="{{ hero_card.name }}">
        {% endif %}
      </div>

      <div class="panel meters-panel">
        <div class="meters">
          <div>
            <div class="meter-label">Dificultad</div>
            {{ dots(hero.difficulty) }}
          </div>
          <div>
            <div class="meter-label">Potencia</div>
            {{ dots(hero.power, extra='power') }}
          </div>
        </div>

        <div>
          <div class="sub-title">Aspectos</div>
          <div class="aspect-grid">
            <div></div>
            {% for label in table_headers %}<div class="ag-head">{{ label }}</div>{% endfor %}
            {% for aspect in aspects %}
            <div class="ag-name aspect-{{ aspect.key }}">{{ aspect.label }}</div>
            {% for rating in aspect.ratings %}
            <div class="ag-cell ag-{{ aspect.key }}">{{ dots(rating, extra='small') }}</div>
            {% endfor %}
            {% endfor %}
          </div>
        </div>
      </div>
    </div>

    <div class="panel">
      <div class="panel-title">Fortalezas</div>
      <ul class="item-list">
        {% for item in hero.strengths %}<li>{{ item }}</li>{% endfor %}
      </ul>
    </div>

    <div class="panel">
      <div class="panel-title">Debilidades</div>
      <ul class="item-list">
        {% for item in hero.weaknesses %}<li>{{ item }}</li>{% endfor %}
      </ul>
    </div>

    <div class="panel">
      <div class="panel-title">Básicas que pegan con él</div>
      <p class="aside-note">Van en casi cualquier mazo de este héroe, da igual el aspecto.</p>
      <div class="rec-basics" style="margin-top:2mm;">
        {% for card in recommended_basics %}
        <div class="rec-basic">
          {% if card.image %}<img src="{{ card.image }}" alt="{{ card.name }}">{% endif %}
          <div>
            <div class="sig-name">{{ card.name }}</div>
            <div class="type-tag">{{ card.type_label }} · básica</div>
            <p class="note">{{ card.note }}</p>
          </div>
        </div>
        {% endfor %}
      </div>
    </div>

    <div class="panel">
      <div class="panel-title">Si juegas este aspecto</div>
      <p class="aside-note">Una carta por color, solo como avance. El mazo entero iría en su propia ficha.</p>
      <div class="rec-aspects" style="margin-top:2mm;">
        {% for card in recommended_aspects %}
        <div class="rec-aspect {{ card.aspect }}">
          <div class="bar">{{ card.aspect_label }}</div>
          <div class="inner">
            {% if card.image %}<img src="{{ card.image }}" alt="{{ card.name }}">{% endif %}
            <div>
              <div class="name">{{ card.name }}</div>
              <p class="note">{{ card.note }}</p>
            </div>
          </div>
        </div>
        {% endfor %}
      </div>
    </div>
  </div>

  <footer class="footer">Propuesta de maquetación · no sustituye a la hoja de héroe</footer>
</section>

<section class="sheet sheet-b">
  <div class="halftone"></div>
  <div class="proposal-banner">Cara B sin cartas ajenas al kit · aquí solo el set de firma</div>

  <header class="header">
    <div>
      <div class="eyebrow">Cartas propias y consideraciones de juego</div>
      <div class="hero-name">{{ hero_card.name }}</div>
    </div>
  </header>

  <div class="body">
    <div>
      <div class="panel-title">Mejores cartas</div>
      <div class="card-grid">
        {% for card in key_cards %}
        <div class="sig-card">
          <div class="sig-art">
            {% if card.image %}<img src="{{ card.image }}" alt="{{ card.name }}">{% endif %}
          </div>
          <div class="sig-name">{{ card.name }}</div>
          <div class="sig-meta">
            <span class="type-tag">{{ card.type_label }} · x{{ card.quantity }}</span>
            {{ dots(card.priority, extra='small') }}
          </div>
          <p class="sig-note">{{ card.note }}</p>
        </div>
        {% endfor %}
      </div>
    </div>

    <div>
      <div class="panel-title">Cartas circunstanciales</div>
      <div class="mini-grid">
        {% for card in other_cards %}
        <div class="mini">
          {% if card.image %}<img src="{{ card.image }}" alt="{{ card.name }}">{% endif %}
          <div class="mini-info">
            <div class="sig-name">{{ card.name }}</div>
            <div class="sig-meta">
              <span class="type-tag">{{ card.type_label }} · x{{ card.quantity }}</span>
              {{ dots(card.priority, extra='small') }}
            </div>
            <p class="sig-note">{{ card.note }}</p>
          </div>
        </div>
        {% endfor %}
      </div>
    </div>

    <div class="panel">
      <div class="panel-title">Consideraciones</div>
      <ul class="item-list">
        {% for item in hero.consideraciones %}<li>{{ item }}</li>{% endfor %}
      </ul>
    </div>

    <div class="panel">
      <div class="panel-title">Mulligan</div>
      <div class="split-lists">
        <div>
          <div class="sub-title">Buscar</div>
          <ul class="item-list">
            {% for item in hero.mulligan.keep %}<li>{{ item }}</li>{% endfor %}
          </ul>
        </div>
        <div>
          <div class="sub-title">Cambia</div>
          <ul class="item-list">
            {% for item in hero.mulligan.toss %}<li>{{ item }}</li>{% endfor %}
          </ul>
        </div>
      </div>
    </div>
  </div>

  <footer class="footer">Propuesta de maquetación · no sustituye a la hoja de héroe</footer>
</section>

</body>
</html>
