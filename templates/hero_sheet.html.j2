{% macro notes(sections) -%}
{% for section in sections %}
<div class="notes notes-{{ section.tone | default('consejo') }}">
  <div class="notes-title">{{ section.title }}</div>
  <ul>
    {% for item in section['items'] %}<li>{{ item }}</li>{% endfor %}
  </ul>
</div>
{% endfor %}
{%- endmacro %}

{% macro dots(value, total=5, extra='') -%}
<div class="dots {{ extra }}">
  {% for i in range(1, total + 1) %}
  <div class="dot {% if i <= value %}on{% endif %} {{ extra }}"></div>
  {% endfor %}
</div>
{%- endmacro %}

<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<title>{{ hero_card.name }} — Hoja de héroe · Marvel Champions</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bangers&family=Barlow+Condensed:wght@500;600;700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
:root {
  --primary: {{ palette.primary }};
  --secondary: {{ palette.secondary }};
  --on-primary: {{ palette.on_primary }};
  --on-secondary: {{ palette.on_secondary }};
  --primary-ink: color-mix(in srgb, {{ palette.primary }} 72%, #000);
  --ink: #141414;
  --paper: #f4efe4;
  --paper-light: #fbf8f1;
  --accent: #f2b705;
}
{% include "sheet.css" %}
</style>
</head>
<body>

{# ============================ CARA A — PRESENTACIÓN ============================ #}
<section class="sheet sheet-a">
  <div class="halftone"></div>

  <header class="header">
    <div>
      <div class="eyebrow">Guía básica de héroe · Marvel Champions LCG</div>
      <div class="hero-name">{{ hero_card.name }}</div>
      <div class="alter-ego-name">{{ alter_ego.name }}</div>
    </div>
    {% if hero.level %}
    <div class="tags">
      <div class="level-tag">Nivel {{ hero.level }}</div>
    </div>
    {% endif %}
  </header>

  <div class="body">
    <div class="row">
      <div class="portrait">
        {% if hero_card.image %}
        <img class="card-art" src="{{ hero_card.image }}" alt="{{ hero_card.name }}">
        {% endif %}
      </div>

      <div class="panel meters-panel">
        <div class="meters">
          <div>
            <div class="meter-label">Dificultad</div>
            {{ dots(hero.difficulty) }}
          </div>
          <div>
            <div class="meter-label">Potencia</div>
            {{ dots(hero.power, extra='power') }}
          </div>
        </div>

        {% if 'aspectos' not in hide %}
        <div>
          <div class="sub-title">¿Con qué aspecto lo acompaño?</div>
          <div class="aspects">
            {% for aspect in aspects %}
            <div class="aspect aspect-{{ aspect.key }}">
              <div class="name">{{ aspect.label }}</div>
              {{ dots(aspect.rating, extra='small') }}
            </div>
            {% endfor %}
          </div>
        </div>
        {% endif %}
      </div>
    </div>

    {% if 'fuertes-debiles' not in hide %}
    <div class="panel">
      <div class="panel-title">Puntos fuertes y débiles</div>
      <div class="pros-cons">
        <ul class="pc-list pros">
          {% for item in hero.strengths %}
          <li>{{ item }}</li>
          {% endfor %}
        </ul>
        <ul class="pc-list cons">
          {% for item in hero.weaknesses %}
          <li>{{ item }}</li>
          {% endfor %}
        </ul>
      </div>
    </div>
    {% endif %}

    {{ notes(sections_a) }}
  </div>

  <footer class="footer">Hoja no oficial hecha por aficionados · Marvel Champions LCG © Fantasy Flight Games / Marvel · Datos e imágenes de MarvelCDB</footer>
</section>

{# ============================ CARA B — CARTAS Y ESTRATEGIA ============================ #}
<section class="sheet sheet-b">
  <div class="halftone"></div>

  <header class="header">
    <div>
      <div class="eyebrow">Cartas propias y consejos de juego</div>
      <div class="hero-name">{{ hero_card.name }}</div>
    </div>
    {% if hero.level %}
    <div class="tags">
      <div class="level-tag">Nivel {{ hero.level }}</div>
    </div>
    {% endif %}
  </header>

  <div class="body">
    <div>
      <div class="panel-title">Mejores cartas</div>
      <div class="card-grid">
        {% for card in key_cards %}
        <div class="sig-card">
          <div class="sig-art">
            {% if card.image %}<img src="{{ card.image }}" alt="{{ card.name }}">{% endif %}
          </div>
          <div class="sig-name">{{ card.name }}</div>
          <div class="sig-meta">
            <span class="type-tag">{{ card.type_label }} · x{{ card.quantity }}</span>
            {{ dots(card.priority, extra='small') }}
          </div>
          <p class="sig-note">{{ card.note }}</p>
        </div>
        {% endfor %}
      </div>
    </div>

    {% if 'circunstanciales' not in hide %}
    <div>
      <div class="panel-title">Cartas circunstanciales</div>
      <div class="mini-grid">
        {% for card in other_cards %}
        <div class="mini">
          {% if card.image %}<img src="{{ card.image }}" alt="{{ card.name }}">{% endif %}
          <div class="mini-info">
            <div class="sig-name">{{ card.name }}</div>
            <div class="sig-meta">
              <span class="type-tag">{{ card.type_label }} · x{{ card.quantity }}</span>
              {{ dots(card.priority, extra='small') }}
            </div>
            <p class="sig-note">{{ card.note }}</p>
          </div>
        </div>
        {% endfor %}
      </div>
    </div>
    {% endif %}

    {% if 'consejos' not in hide %}
    <div class="combos">
      <div class="panel-title" style="margin-bottom:1.6mm;">Consejos</div>
      <div class="combo-grid">
        {% for combo in hero.combos %}
        <div class="combo">
          <span class="chain">{{ combo.chain }}</span>
          <span>{{ combo.text }}</span>
        </div>
        {% endfor %}
      </div>
    </div>
    {% endif %}

    {% if not ('curva' in hide and 'mulligan' in hide) %}
    <div class="row">
      {% if 'curva' not in hide %}
      <div class="panel" style="flex:0 0 62mm;">
        <div class="panel-title">Curva de coste</div>
        <div class="curve">
          {% for bucket in curve %}
          <div class="curve-col">
            <div class="curve-n">{{ bucket.count }}</div>
            <div class="curve-bar" style="height:{{ bucket.height }}%;"></div>
            <div class="curve-cost">{{ bucket.label }}</div>
          </div>
          {% endfor %}
        </div>
      </div>
      {% endif %}

      {% if 'mulligan' not in hide %}
      <div class="panel" style="flex:1 1 auto;">
        <div class="panel-title">Mano inicial: qué quedarse y qué cambiar</div>
        <ul class="mulligan">
          {% for item in hero.mulligan.keep %}
          <li class="keep" data-mark="✔">{{ item }}</li>
          {% endfor %}
          {% for item in hero.mulligan.toss %}
          <li class="toss" data-mark="✘">{{ item }}</li>
          {% endfor %}
        </ul>
      </div>
      {% endif %}
    </div>
    {% endif %}

    {{ notes(sections_b) }}
  </div>

  <footer class="footer">Hoja no oficial hecha por aficionados · Marvel Champions LCG © Fantasy Flight Games / Marvel · Datos e imágenes de MarvelCDB</footer>
</section>

</body>
</html>
