{% macro notes(sections) -%}
{% for section in sections %}
<div class="notes notes-{{ section.tone | default('consejo') }}">
  <div class="notes-title">{{ section.title }}</div>
  <ul>
    {% for item in section['items'] %}<li>{{ item }}</li>{% endfor %}
  </ul>
</div>
{% endfor %}
{%- endmacro %}

{% macro dots(value, total=5, extra='') -%}
<div class="dots {{ extra }}">
  {% for i in range(1, total + 1) %}
  <div class="dot {% if i <= value %}on{% endif %} {{ extra }}"></div>
  {% endfor %}
</div>
{%- endmacro %}

{% macro aspect_bar(value, total=5) -%}
<div class="aspect-bar" aria-hidden="true">
  <span style="width: {{ value * 100 / total }}%"></span>
</div>
{%- endmacro %}

<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<title>{{ hero_card.name }} — Hoja de héroe · Marvel Champions</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bangers&family=Barlow+Condensed:wght@500;600;700&family=Inter:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,500&display=swap" rel="stylesheet">
<style>
:root {
  --primary: {{ palette.primary }};
  --secondary: {{ palette.secondary }};
  --on-primary: {{ palette.on_primary }};
  --on-secondary: {{ palette.on_secondary }};
  --primary-ink: color-mix(in srgb, {{ palette.primary }} 72%, #000);
  --ink: #141414;
  --paper: #f4efe4;
  --paper-light: #fbf8f1;
  --accent: #f2b705;
}
{% include "sheet.css" %}
</style>
</head>
<body>

{# ============================ CARA A — PRESENTACIÓN ============================ #}
<section class="sheet sheet-a">
  <div class="halftone"></div>

  <header class="header">
    <div>
      <div class="eyebrow">Guía básica de héroe · Marvel Champions LCG</div>
      <div class="hero-name">{{ hero_card.name }}</div>
      <div class="alter-ego-name">{{ alter_ego.name }}</div>
    </div>
  </header>

  <div class="body">
    <div class="row">
      <div class="portrait">
        {% if hero_card.image %}
        <img class="card-art" src="{{ hero_card.image }}" alt="{{ hero_card.name }}">
        {% endif %}
      </div>

      <div class="panel meters-panel">
        <div class="meters">
          <div>
            <div class="meter-label">Dificultad</div>
            {{ dots(hero.difficulty) }}
          </div>
          <div>
            <div class="meter-label">Nivel de poder</div>
            {{ dots(hero.power, extra='power') }}
          </div>
        </div>

        {% if 'aspectos' not in hide %}
        <div class="aspects-block">
          <div class="aspect-grid">
            <div class="ag-head ag-head-aspects">Aspectos</div>
            {% for label in table_headers %}<div class="ag-head">{{ label }}</div>{% endfor %}
            {% for aspect in aspects %}
            <div class="ag-name aspect-{{ aspect.key }}">{{ aspect.label }}</div>
            {% for rating in aspect.ratings %}
            <div class="ag-cell ag-{{ aspect.key }}">{{ aspect_bar(rating) }}</div>
            {% endfor %}
            {% endfor %}
          </div>
        </div>
        {% endif %}
      </div>
    </div>

    {% if 'fortalezas' not in hide %}
    <div class="panel">
      <div class="panel-title">Fortalezas</div>
      <ul class="item-list">
        {% for item in hero.strengths %}<li>{{ item }}</li>{% endfor %}
      </ul>
    </div>
    {% endif %}

    {% if 'debilidades' not in hide %}
    <div class="panel">
      <div class="panel-title">Debilidades</div>
      <ul class="item-list">
        {% for item in hero.weaknesses %}<li>{{ item }}</li>{% endfor %}
      </ul>
    </div>
    {% endif %}

    {% if 'basicas' not in hide and basic_cards %}
    <div class="panel">
      <div class="panel-title">Cartas básicas indispensables</div>
      <div class="rec-basics rec-basics-{{ basic_cards|length }}">
        {% for card in basic_cards %}
        <div class="rec-basic">
          {% if card.image %}<img src="{{ card.image }}" alt="{{ card.name }}">{% endif %}
          <div>
            <div class="sig-name">{{ card.name }}</div>
            <span class="type-tag">{{ card.type_label }}</span>
            <p class="sig-note">{{ card.note }}</p>
          </div>
        </div>
        {% endfor %}
      </div>
    </div>
    {% endif %}

    {% if 'mazos' not in hide and mazos %}
    <div class="panel">
      <div class="panel-title">Mazos recomendados</div>
      <div class="rec-mazos rec-mazos-{{ mazos|length }}">
        {% for mazo in mazos %}
        <div class="rec-mazo rec-mazo-{{ mazo.aspect }}">
          <div class="rec-mazo-art">
            {% if mazo.image %}<img src="{{ mazo.image }}" alt="{{ mazo.face_name }}">{% endif %}
          </div>
          <div class="rec-mazo-title">
            <span class="rec-mazo-aspecto aspect-{{ mazo.aspect }}">{{ mazo.aspect_label }}</span>
            {{ mazo.name }}
            {% if mazo.note %}<p class="sig-note">{{ mazo.note }}</p>{% endif %}
          </div>
        </div>
        {% endfor %}
      </div>
    </div>
    {% endif %}

    {{ notes(sections_a) }}
  </div>

  <footer class="footer">Hoja no oficial hecha por y para la comunidad · Marvel Champions LCG © Fantasy Flight Games / Marvel · Datos e imágenes de MarvelCDB</footer>
</section>

{# ============================ CARA B — CARTAS Y ESTRATEGIA ============================ #}
<section class="sheet sheet-b">
  <div class="halftone"></div>

  <header class="header">
    <div>
      <div class="eyebrow">Cartas propias y consideraciones de juego</div>
      <div class="hero-name">{{ hero_card.name }}</div>
      <div class="alter-ego-name">{{ alter_ego.name }}</div>
    </div>
  </header>

  <div class="body">
    <div>
      <div class="panel-title">Mejores cartas</div>
      <div class="card-grid">
        {% for card in key_cards %}
        <div class="sig-card">
          <div class="sig-art">
            {% if card.image %}<img src="{{ card.image }}" alt="{{ card.name }}">{% endif %}
          </div>
          <div class="sig-name">{{ card.name }}</div>
          <div class="sig-meta">
            <span class="type-tag">{{ card.type_label }} · x{{ card.quantity }}</span>
            {{ dots(card.priority, extra='small') }}
          </div>
          <p class="sig-note">{{ card.note }}</p>
        </div>
        {% endfor %}
      </div>
    </div>

    {% if 'circunstanciales' not in hide %}
    <div>
      <div class="panel-title">Cartas circunstanciales</div>
      <div class="mini-grid">
        {% for card in other_cards %}
        <div class="mini">
          {% if card.image %}<img src="{{ card.image }}" alt="{{ card.name }}">{% endif %}
          <div class="mini-info">
            <div class="sig-name">{{ card.name }}</div>
            <div class="sig-meta">
              <span class="type-tag">{{ card.type_label }} · x{{ card.quantity }}</span>
              {{ dots(card.priority, extra='small') }}
            </div>
            <p class="sig-note">{{ card.note }}</p>
          </div>
        </div>
        {% endfor %}
      </div>
    </div>
    {% endif %}

    {% if 'consideraciones' not in hide %}
    <div class="panel">
      <div class="panel-title">Consideraciones</div>
      <ul class="item-list">
        {% for item in hero.consideraciones %}
        <li>{% if item is mapping %}{% if item.chain %}<b>{{ item.chain }}.</b> {% endif %}{{ item.text }}{% else %}{{ item }}{% endif %}</li>
        {% endfor %}
      </ul>
    </div>
    {% endif %}

    {% if 'mulligan' not in hide %}
    <div class="panel">
      <div class="panel-title">Mulligan</div>
      <div class="split-lists">
        <div>
          <div class="sub-title">Buscar</div>
          <ul class="item-list">
            {% for item in hero.mulligan.keep %}<li>{{ item }}</li>{% endfor %}
          </ul>
        </div>
        <div>
          <div class="sub-title">Cambia</div>
          <ul class="item-list">
            {% for item in hero.mulligan.toss %}<li>{{ item }}</li>{% endfor %}
          </ul>
        </div>
      </div>
    </div>
    {% endif %}

    {{ notes(sections_b) }}
  </div>

  <footer class="footer">Hoja no oficial hecha por y para la comunidad · Marvel Champions LCG © Fantasy Flight Games / Marvel · Datos e imágenes de MarvelCDB</footer>
</section>

</body>
</html>
